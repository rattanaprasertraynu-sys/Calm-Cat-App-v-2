.sad-stain {
  position: absolute;

  width: 70px;
  height: 70px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(255,255,255,0.10) 0%,
      rgba(255,255,255,0.05) 45%,
      rgba(255,255,255,0.02) 65%,
      transparent 85%
    );

  filter: blur(5px);

  pointer-events: none;
}

.sad-text-wrapper {
  position: relative;

  width: 100%;
