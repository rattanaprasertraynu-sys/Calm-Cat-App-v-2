@keyframes fadeInSoft {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes breathing {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }

  100% {
    transform: scale(1);
  }
}

@keyframes tiredBreathing {
  0% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.12);
  }

  100% {
    transform: scale(1);
  }
}

.tired-breathing {
  animation: tiredBreathing 2s ease-in-out infinite;
}

@keyframes floatingHeart {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }

  50% {
    opacity: 1;
  }

  100% {
    opacity: 0;
    transform: translateY(-40px);
  }
}

@keyframes sweepAway {
  to {
    transform: translateX(600px);
    opacity: 0;
  }
}

.fade-soft {
  animation: fadeInSoft 0.8s ease;
}

.breathing {
  animation: breathing 4s ease-in-out infinite;
}

.floating-heart {
  animation: floatingHeart 2s ease forwards;
}
